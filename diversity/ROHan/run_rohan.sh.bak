#!/bin/bash
# =============================================================================
# run_rohan.sh — Runs of Homozygosity using ROHan (Renaud et al. 2019)
#
# Submitted as a SLURM job array by launch_rohan.sh.  Each array task reads
# its own chunk of samples from bamlist_chunk_${SLURM_ARRAY_TASK_ID}.txt.
#
# Sample preparation:
#   BAMs in bamlist_rohan.txt are already filtered (>3x) and downsampled
#   (>6x → 6x) by prep_samples.sh.  No further coverage filtering here.
#
# rohmu parameter:
#   Read from chosen_rohmu.txt (written by estimate_rohmu.sh).  This is an
#   empirically calibrated value for Deinandra, selected as the value in the
#   Taylor et al. (2024) test range {5e-5, 8e-5, 2e-4, 5e-4, 8e-4, 2e-3}
#   that minimises mean |F_ROH(6x) - F_ROH(3x)| across calibration samples.
#
# Two-pass approach:
#   Pass 1 (--nohmm): MCMC het estimation → writes hEst.gz
#   Pass 2 (--hmm):   reads hEst.gz, runs HMM → writes .summary.txt and
#                     .{max,mid,min}.hmmrohl.gz ROH call files
#   Separating the passes allows HMM parameters (rohmu) to be adjusted and
#   rerun cheaply without repeating the expensive MCMC step.
#
# Key parameters:
#   --tstv 1.86    Ts/Tv ratio from postNGSparalog_auto.vcf.gz (calc_tstv.sh)
#   --chains 10000 Reduced from default 50000; default caused timeout on test
#                  sample at ~2x coverage (confirmed ~200 hrs/sample)
#   --size 100000  100 kb windows; matched to bcftools roh pipeline for
#                  comparability; also sets minimum detectable ROH length
#   --rohmu        Empirical value from chosen_rohmu.txt (not the default 1e-5,
#                  which is calibrated for humans and underestimates ROH in
#                  non-human species; Taylor et al. 2024)
#
# Scaffold filtering: scaffolds >= 1 Mb (24 scaffolds = 99.6% of the genome
#   covered by >=500 kb scaffolds).  Minimum of 10 windows per scaffold is
#   needed for the HMM to reliably distinguish ROH from background noise.
#
# Output collection: run collect_rohan.sh once all array tasks finish.
# =============================================================================

#SBATCH --job-name=ROHan
#SBATCH --partition=long
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=esteiger@ucsc.edu
#SBATCH --nodes=1
#SBATCH --ntasks=5
#SBATCH --mem=30gb
#SBATCH --time=168:00:00
#SBATCH --output=/private/groups/meyerlab/esteiger/diversity/ROH/ROHan/rohan_%A_%a.log

set -euo pipefail

ROHAN=/private/groups/meyerlab/esteiger/software/rohan/bin/rohan
REF=/private/groups/meyerlab/esteiger/genome/DEINVI_genome.fasta.masked
OUTDIR=/private/groups/meyerlab/esteiger/diversity/ROH/ROHan
CHUNK="$OUTDIR/bamlist_chunk_${SLURM_ARRAY_TASK_ID}.txt"
SCAFFOLDS="$OUTDIR/scaffolds_1mb_names.txt"
ROHMU=$(cat "$OUTDIR/chosen_rohmu.txt")

echo "Array task ${SLURM_ARRAY_TASK_ID}: $(wc -l < "$CHUNK") samples, rohmu=${ROHMU}"

# --- Per-sample ROHan runner (two-pass) --------------------------------------
run_rohan_sample() {
    local bam="$1"
    local sample
    # Handles both original ({sample}_rmdup.bam) and subsampled ({sample}_sub6x.bam)
    sample=$(basename "$bam" .bam)   # strip .bam → e.g. "4532_rmdup" or "4532_sub6x"
    sample="${sample%_rmdup}"        # strip _rmdup suffix if present
    sample="${sample%_sub6x}"        # strip _sub6x suffix if present
    local prefix="$OUTDIR/${sample}"

    if [[ -s "${prefix}.summary.txt" ]]; then
        echo "[$sample] Skipping — summary already exists"
        return 0
    fi

    # Pass 1: het estimation (MCMC) — skip if hEst.gz already written
    if [[ ! -s "${prefix}.hEst.gz" ]]; then
        echo "[$sample] Pass 1: MCMC het estimation ..."
        "$ROHAN" \
            --tstv 1.86 \
            --size 100000 \
            --chains 10000 \
            --nohmm \
            --auto "$SCAFFOLDS" \
            -o "$prefix" \
            "$REF" "$bam" \
            2>> "${prefix}.log"
        echo "[$sample] Pass 1 complete."
    else
        echo "[$sample] hEst.gz exists — skipping Pass 1"
    fi

    # Pass 2: HMM ROH calling with empirical rohmu
    echo "[$sample] Pass 2: HMM ROH calling (rohmu=${ROHMU}) ..."
    "$ROHAN" \
        --tstv 1.86 \
        --size 100000 \
        --chains 10000 \
        --hmm \
        --rohmu "$ROHMU" \
        --auto "$SCAFFOLDS" \
        -o "$prefix" \
        "$REF" "$bam" \
        2>> "${prefix}.log"
    echo "[$sample] Done."
}

export -f run_rohan_sample
export OUTDIR REF ROHAN SCAFFOLDS ROHMU

parallel -j 5 run_rohan_sample {} < "$CHUNK"

echo "Array task ${SLURM_ARRAY_TASK_ID} finished."
